# Server Configuration
PORT=5000
NODE_ENV=development

# Redis
# Local dev (no Docker): redis://localhost:6379
# Inside Docker Compose:  redis://redis:6379
REDIS_URL=redis://localhost:6379

# Service Integration URLs
FRONTEND_URL=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000

# Firebase Client Config (Matched with Frontend)
FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Firebase Admin SDK Config
# NOTE: Replace literal \n with actual newlines if required by your environment loader, 
# or keep as \n if the code replaces it via `.replace(/\\n/g, '\n')` (which it does in src/config/env.ts).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR\nPRIVATE\nKEY\nHERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com

# Google OAuth Config
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AngelOne SmartAPI Integration (Read-Only Market Data Scope)
# SECURITY NOTE: For production deployments, use a dedicated Angel One SmartAPI key
# restricted strictly to market-data endpoints with trading/order-execution permissions disabled.
SMARTAPI_CLIENT_CODE=your_client_code
SMARTAPI_PASSWORD=your_password
SMARTAPI_TOTP_SECRET=your_totp_secret_key
SMARTAPI_API_KEY=your_smartapi_key
SMARTAPI_LOCAL_IP=192.168.1.100
SMARTAPI_PUBLIC_IP=203.0.113.1
SMARTAPI_MAC_ADDRESS=00:1A:2B:3C:4D:5E

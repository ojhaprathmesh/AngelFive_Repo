{
  "name": "@angelfive/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express backend server for AngelFive project",
  "author": "Angel Five Team",
  "license": "MIT",
  "keywords": [
    "express",
    "typescript",
    "backend",
    "api"
  ],
  "main": "dist/server.js",
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "nodemon -L src/server.ts",
    "dev:worker": "nodemon -L src/worker-run.ts",
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc --build --force",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker-run.js",
    "test": "NODE_ENV=test tsx --test tests/**/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "bullmq": "^5.76.8",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.5.1",
    "express-validator": "^7.3.1",
    "firebase-admin": "^13.7.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.10.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rimraf": "^5.0.10",
    "speakeasy": "^2.0.0",
    "tslib": "^2.8.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.35",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.39.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
